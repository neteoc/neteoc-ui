rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the 'missions' collection
    match /missions/{missionId} {
      // Allow read to any authenticated user
      allow read: if request.auth != null;
      // Allow write (update, delete) only if the user is the owner of the mission
      allow write: if request.auth.uid == resource.data.ownerID;
    }
    // Match any other document and allow read, write if authenticated
    match /{document=**} {
      allow read: if request.auth != null;
    }
  }
}