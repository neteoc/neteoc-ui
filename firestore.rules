rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /recruiting/{submissionID}{
      allow read: if request.auth != null;
    }
    match /users/{userId} {
      match /pubDetails/{object} {
        allow read: if request.auth != null;
      }
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }
    // Match any document in the 'missions' collection
    match /missions/{missionId} {
      match /roster/{userId} {
        // Allow read to any authenticated user
        allow read: if request.auth != null;
        // Allow create to any authenticated user
        allow write: if request.auth.uid == userId;
      }
      // Allow read to any authenticated user
      allow read: if request.auth != null;
      // Allow create to any authenticated user
      allow create: if request.auth != null;
      // Allow write (update, delete) only if the user is the owner of the mission
      allow write: if request.auth.uid == resource.data.ownerID;
    }
    // Match any document in the 'mission-requests' collection
    match /mission-requests/{missionRequestId} {
      // Allow create if the user has the 'missionrequestor' role
      allow create: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(["missionrequestor", "superadmin" ]);
      allow read: if request.auth != null && ( request.auth.uid == resource.data.submittedBy || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([ "superadmin" ]));
      allow write: if request.auth != null && ( request.auth.uid == resource.data.submittedBy || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([ "superadmin" ]));
    }
  }
}